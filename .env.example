# ORBLUX — variáveis de ambiente (camada social)
# Copie este arquivo para `.env` (NUNCA commite .env — ver .gitignore).
#
# A chave ANON é PÚBLICA por design (segura no cliente) e vai em
# net/config.js ou no localStorage `pn_social_config` em homologação.
#
# A chave service_role NUNCA sai daqui para o cliente: existe apenas no
# ambiente das Edge Functions (configurada no dashboard do Supabase).

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-publishable

# service_role — só no servidor (Edge Functions / pg_cron via dashboard)
# SUPABASE_SERVICE_ROLE_KEY=
